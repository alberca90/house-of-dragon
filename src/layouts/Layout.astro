---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · House of the Dragon: Libro vs Serie</title>
	</head>
	<body class="min-h-screen bg-neutral-950 text-neutral-100">
		<header class="border-b border-neutral-800">
			<nav class="mx-auto flex max-w-5xl items-center justify-between p-4">
				<a href="/" class="text-lg font-bold">🐉 Libro vs Serie</a>
				<div class="flex gap-4 text-sm">
					<a href="/personajes" class="hover:text-neutral-300">Personajes</a>
					<a href="/hitos" class="hover:text-neutral-300">Hitos</a>
				</div>
			</nav>
		</header>
		<main class="mx-auto max-w-5xl p-4">
			<slot />
		</main>
		<footer class="mx-auto max-w-5xl p-4 text-center text-xs text-neutral-500">
			Proyecto de prueba: Fuego y Sangre vs. La Casa del Dragón
		</footer>
	</body>
</html>
