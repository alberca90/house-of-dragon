---
import Layout from '../../layouts/Layout.astro';
import PersonajeCard from '../../components/PersonajeCard.astro';
import { getCollection } from 'astro:content';

const personajes = await getCollection('personajes');
---

<Layout title="Personajes">
	<h1 class="mb-6 text-3xl font-bold">Personajes</h1>
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
		{personajes.map((personaje) => <PersonajeCard personaje={personaje} />)}
	</div>
</Layout>
