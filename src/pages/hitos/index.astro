---
import Layout from '../../layouts/Layout.astro';
import HitoCard from '../../components/HitoCard.astro';
import { getCollection } from 'astro:content';

const hitos = await getCollection('hitos');
---

<Layout title="Hitos">
	<h1 class="mb-6 text-3xl font-bold">Hitos: Libro vs Serie</h1>
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
		{hitos.map((hito) => <HitoCard hito={hito} />)}
	</div>
</Layout>
